  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "news_01",
    "text": "政府は来年度の予算案を閣議決定し、総額は過去最大となる見通しです。",
    "category": "news",
    "file": "eval_texts/tts/griffinlim/news_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "conv_01",
    "text": "ねえ、今日のお昼どうする?",
