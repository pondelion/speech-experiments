    "file": "eval_texts/tts/griffinlim/conv_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "num_01",
    "text": "2026年11月6日の午後3時15分に集合してください。",
    "category": "number",
    "file": "eval_texts/tts/griffinlim/num_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "alpha_01",
    "text": "AIを使った新しいアプリを公開しました。",
    "category": "alphabet",
    "file": "eval_texts/tts/griffinlim/alpha_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "place_01",
    "text": "御徒町から秋葉原までは歩いて行けます。",
    "category": "proper_noun",
    "file": "eval_texts/tts/griffinlim/place_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "homo_01",
    "text": "今日は朝から雨が降っています。",
    "category": "homograph",
    "file": "eval_texts/tts/griffinlim/homo_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "long_01",
    "text": "本日は、お忙しいところ説明会にお越しいただき、誠にありがとうございます。これから約一時間、新しいサービスの概要と、今後のスケジュールについて順番にご説明いたしますので、最後までどうぞよろしくお願いいたします。",
    "category": "long",
    "file": "eval_texts/tts/griffinlim/long_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "short_01",
    "text": "はい。",
    "category": "short",
    "file": "eval_texts/tts/griffinlim/short_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
    "id": "q_01",
    "text": "本当にそれでいいんですか?",
    "category": "question_exclamation",
    "file": "eval_texts/tts/griffinlim/q_01.mp3"
  },
  {
    "group": "eval_texts",
    "condition": "tts/griffinlim",
