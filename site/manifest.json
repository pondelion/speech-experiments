              {"id": "ar/t2s_ph_k256_aux", "label": "自己回帰 + 補助の損失", "cer": {"test": 0.263, "eval_texts": 0.268}, "default": true}
            ]},
            {"title": "非自己回帰", "conditions": [
              {"id": "t2s_duration", "label": "FastSpeech2 系", "cer": {"test": 0.347, "eval_texts": 0.233}, "default": true},
              {"id": "t2s_masked", "label": "MaskGCT 系", "cer": {"test": 0.192, "eval_texts": 0.243}, "default": true}
