            {"title": "ハイブリッド型(長さの予測 + MaskGCT 系)", "conditions": [
              {"id": "t2s_hybrid_nar", "label": "ハイブリッド(長さを一度に予測)", "cer": {"test": 0.119, "eval_texts": 0.095}, "default": true},
              {"id": "t2s_hybrid_ar", "label": "ハイブリッド(長さを自己回帰で予測)", "cer": {"test": 0.185, "eval_texts": 0.109}}
            ]},
            {"title": "分析用: 長さだけ正解を与える", "conditions": [
              {"id": "t2s_duration/gt_length", "label": "FastSpeech2 系 + 正解の長さ", "cer": {"test": 0.373}},
              {"id": "t2s_masked/gt_length", "label": "MaskGCT 系 + 正解の長さ", "cer": {"test": 0.199}},
              {"id": "t2s_hybrid_nar/gt_length", "label": "ハイブリッド(一度に)+ 正解の長さ", "cer": {"test": 0.103}},
              {"id": "t2s_hybrid_ar/gt_length", "label": "ハイブリッド(自己回帰)+ 正解の長さ", "cer": {"test": 0.118}}
            ]}
          ]
        },
